-- Script appended to every miniature (leader or not) when a unit is spawned.
--
-- Kept as a string so it can be concatenated at runtime by SpawnList without
-- reading it from a template object. It wraps any event handlers already
-- defined by the leader script rather than replacing them.
function getMiniSharedScript()
  return [==[

-- avoid minis being flipped upside down when dropped on terrain.
-- snap leader mini to battlefield edge.

local _shared = {
  edgeSnapBand  = 3.0,  -- inches outside the edge within which a drop snaps, also works on sides, but not great
  hugLift       = 0.02,
  tiltLimit     = 0.7,  -- roughly cos(45deg); below this the mini is tipped
  pendingSettle = false,
  heldBy        = nil,
}

local function _options()
  return Global.getTable("miniOptions") or {}
end

local function _baseRadius()
  local size = baseSize
  if size == nil and leaderGUID ~= nil then
    local leader = getObjectFromGUID(leaderGUID)
    if leader ~= nil then
      size = leader.getVar("baseSize")
    end
  end
  local info = Global.getTable("templateInfo")
  local diameter = 1.06299
  if info ~= nil and info.baseRadius ~= nil and size ~= nil and info.baseRadius[size] ~= nil then
    diameter = info.baseRadius[size]
  end
  return diameter / 2
end

local function _bottomOffset()
  local bounds = self.getBounds()
  return self.getPosition().y - (bounds.center.y - bounds.size.y / 2)
end

local function _outside(rect, pos)
  local dx = 0
  local dz = 0
  if pos.x < rect.minX then
    dx = rect.minX - pos.x
  elseif pos.x > rect.maxX then
    dx = pos.x - rect.maxX
  end
  if pos.z < rect.minZ then
    dz = rect.minZ - pos.z
  elseif pos.z > rect.maxZ then
    dz = pos.z - rect.maxZ
  end
  return dx, dz
end

-- Make sure the model stands uprht

function sharedFixUpright()
  if self.held_by_color ~= nil then
    return
  end
  local up = self.getTransformUp()
  if up.y >= _shared.tiltLimit then
    return
  end
  local forward = self.getTransformForward()
  local yaw
  if math.abs(forward.y) < 0.9 then
    yaw = math.deg(math.atan2(forward.x, forward.z))
  else
    local right = self.getTransformRight()
    yaw = math.deg(math.atan2(right.x, right.z)) - 90
  end
  local pos = self.getPosition()
  self.setVelocity({0, 0, 0})
  self.setAngularVelocity({0, 0, 0})
  self.setRotation({0, yaw, 0})
  self.setPosition({pos.x, pos.y + 0.3, pos.z})
end

local function _scheduleSettle()
  if _shared.pendingSettle or _options().upright == false then
    return
  end
  _shared.pendingSettle = true
  Wait.condition(
    function()
      _shared.pendingSettle = false
      sharedFixUpright()
    end,
    function()
      return self.resting or self.held_by_color ~= nil
    end,
    6,
    function()
      _shared.pendingSettle = false
    end
  )
end

-- Snap to battlefield edge:
-- Snaps unit leader to edge if within limit (3 inch, set in Battlefield.lua) and
-- of the battlefield.

function sharedEdgeSnap()
  -- Only the unit leader snaps.
  if not isAMini then
    return false
  end

  if _options().edgeSnap == false then
    return false
  end

  local rect = Global.call("getBattlefieldRect")
  local pos = self.getPosition()
  local dx, dz = _outside(rect, pos)
  local band = _shared.edgeSnapBand
  if (dx == 0 and dz == 0) or dx > band or dz > band then
    return false
  end

  local r = _baseRadius() + 0.03
  local target = {x = pos.x, y = pos.y, z = pos.z}
  if dx > 0 then
    if pos.x < rect.minX then
      target.x = rect.minX - r
    else
      target.x = rect.maxX + r
    end
  end

  if dz > 0 then
    if pos.z < rect.minZ then
      target.z = rect.minZ - r
    else
      target.z = rect.maxZ + r
    end
  end

  self.setPositionSmooth(target, false, true)
  return true
end

-- Try to override the TTS lifting of minis to make it visually easier to see
-- where the minis are dropped.

function sharedHugCoroutine()
  local color = _shared.heldBy
  local rect = Global.call("getBattlefieldRect")
  local offset = _bottomOffset() + _shared.hugLift
  while _shared.heldBy ~= nil and self.held_by_color == color do
    local player = Player[color]
    if player ~= nil and #player.getHoldingObjects() == 1 then
      local pointer = player.getPointerPosition()
      local dx, dz = _outside(rect, pointer)
      if (dx > 0 or dz > 0) and pointer.y < rect.top + 3 then
        self.setPosition({pointer.x, pointer.y + offset, pointer.z})
        self.setVelocity({0, 0, 0})
        self.setAngularVelocity({0, 0, 0})
      end
    end
    coroutine.yield(0)
  end
  return 1
end


-- Shared functions
function sharedOnPickedUp(color)
  _shared.heldBy = color
  if _options().hug ~= false and Player[color] ~= nil then
    startLuaCoroutine(self, "sharedHugCoroutine")
  end
end

function sharedOnDropped(_color)
  _shared.heldBy = nil
  sharedEdgeSnap()
  _scheduleSettle()
end

function sharedOnCollisionEnter(_info)
  if self.held_by_color ~= nil or self.resting then
    return
  end
  _scheduleSettle()
end

local _prevOnLoad = onload or onLoad
local _prevOnPickedUp = onPickedUp
local _prevOnDropped = onDropped
local _prevOnCollisionEnter = onCollisionEnter
onload = nil

function onLoad(saveState)
  if _prevOnLoad then
    _prevOnLoad(saveState)
  end
end

function onPickedUp(color)
  if _prevOnPickedUp then
    _prevOnPickedUp(color)
  end
  sharedOnPickedUp(color)
end

function onDropped(color)
  if _prevOnDropped then
    _prevOnDropped(color)
  end
  sharedOnDropped(color)
end

function onCollisionEnter(info)
  if _prevOnCollisionEnter then
    _prevOnCollisionEnter(info)
  end
  sharedOnCollisionEnter(info)
end
-- END MINI SHARED -----------------------------------------------------------
]==]
end
